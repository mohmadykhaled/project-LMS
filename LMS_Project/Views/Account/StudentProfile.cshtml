@model LMS_Project.ViewModel.StudentProfileViewModel

@{
    ViewData["Title"] = "Student Profile";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<div class="container" style="direction: ltr;">
    <h2 class="text-center mt-4 text-primary">Student Profile</h2>

    @if (Model != null)
    {
        <div class="row">
            <!-- Left column: student info -->
            <div class="col-md-5">
                <div class="card mb-4">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="https://www.pngitem.com/pimgs/m/30-307416_profile-icon-png-image-free-download-searchpng-employee.png"
                                 class="rounded-circle shadow-sm"
                                 style="width: 150px; height: 150px; object-fit: cover;"
                                 alt="Profile Image">
                        </div>

                        <h5 class="card-title">@Model.FullName</h5>
                        <p class="card-text"><i class="fas fa-envelope"></i> @Model.Email</p>
                        <p class="card-text"><i class="fas fa-user"></i> Username: @Model.UserName</p>
                        <p class="card-text"><i class="fas fa-birthday-cake"></i> Date of Birth: @Model.DateOfBirth?.ToString("yyyy-MM-dd")</p>
                    </div>
                </div>
            </div>

            <!-- Right column: enrolled courses -->
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-book"></i> Enrolled Courses</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.EnrolledCourses?.Any() == true)
                        {
                            <div class="list-group">
                                @foreach (var course in Model.EnrolledCourses)
                                {
                                    <div class="list-group-item list-group-item-action">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">@course.CourseName</h6>
                                        </div>
                                        <p class="mb-1">@course.Description</p>
                                        <small>Instructor: @course.InstructorFullName</small>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">No enrolled courses yet.</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Back to Home</a>
        </div>
    }
    else
    {
        <div class="alert alert-danger text-center mt-4">Student profile data not found.</div>
    }
</div>

<style>
    .card {
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        border: none;
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .list-group-item {
        margin-bottom: 10px;
        border-radius: 5px;
        border-left: 4px solid #007bff;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
}
