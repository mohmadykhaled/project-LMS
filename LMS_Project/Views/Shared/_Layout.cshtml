@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartLMS</title>

    <!-- Bootstrap CSS via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">

    <!-- External styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/LMS_Project.styles.css" />

    <!-- Custom navbar styling -->
    <style>
        .bg-purple {
        background-color: #5c6ac4;
        }

        .nav-line {
        display: flex;
        justify-content: center;
        gap: 20px;
        padding: 10px 0;
        border-bottom: 1px solid #dee2e6;
        }

        .nav-line a {
        color: #fff;
        text-decoration: none;
        font-size: 1rem;
        }

        .nav-line a:hover {
        color: #e0e0e0;
        }
    </style>
    @RenderSection("Styles", required: false)

</head>
<body>
    <header>
        <div class="nav-line bg-purple">
            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
            <a class="nav-link" asp-controller="Home" asp-action="About">About Us</a>
            <a class="nav-link" asp-controller="Home" asp-action="Courses">Courses</a>
            <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
            @if (User.Identity.IsAuthenticated == true)
            {
                <a class="nav-link" asp-controller="Account" asp-action="SignOut">SignOut</a>
                <a class="nav-link" asp-controller="Account" asp-action="RedirectToProfile">Profile</a>
            }
            else
            {
                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                
            }
            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link" asp-controller="Role" asp-action="AddRole">Add Role</a>
                <a class="nav-link" asp-controller="Admin" asp-action="CreateAdmin">Create Admin</a>
                <a class="nav-link" asp-controller="Instructor" asp-action="CreateInstructor" >Create Instructor</a>
                <a class="nav-link" asp-controller="Course" asp-action="Create">Create Course</a>
            }
        </div>
    </header>

    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

   

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
