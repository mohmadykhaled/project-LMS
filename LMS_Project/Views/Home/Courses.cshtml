@{
    ViewData["Title"] = "Courses";
}

<section class="py-5 bg-light">
    <div class="container">
        <h2 class="mb-4">Available Courses</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <img src="~/images/course1.jpg" class="card-img-top" alt="Course">
                    <div class="card-body">
                        <h5 class="card-title">Introduction to Programming</h5>
                        <p class="card-text">Learn the basics of programming using modern tools.</p>
                        <a href="#" class="btn btn-outline-primary">Start Now</a>
                    </div>
                </div>
            </div>
            <!-- كرّر الكارد لباقي الكورسات -->
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <img src="~/images/course2.jpg" class="card-img-top" alt="Course">
                    <div class="card-body">
                        <h5 class="card-title">Data Science</h5>
                        <p class="card-text">Dive into data analysis, machine learning, and data visualization using Python.</p>
                        <a href="#" class="btn btn-outline-primary">Start Now</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <img src="~/images/course3.jpg" class="card-img-top" alt="Course">
                    <div class="card-body">
                        <h5 class="card-title">UI/UX Design</h5>
                        <p class="card-text">Master user interface and user experience design to build intuitive apps and websites.</p>
                        <a href="#" class="btn btn-outline-primary">Start Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

