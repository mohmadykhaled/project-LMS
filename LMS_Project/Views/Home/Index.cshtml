@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-3 fw-bold mb-4 animate__animated animate__fadeInDown">Welcome to SmartLMS</h1>
                <h2 class="display-5 mb-4 animate__animated animate__fadeInDown animate__delay-1s">Your Gateway to Smarter Learning</h2>
                <p class="lead mb-4 animate__animated animate__fadeIn animate__delay-2s">Manage your courses, track progress, and unlock your potential—all in one place.</p>
                <a href="/Home/Courses" class="btn btn-primary btn-lg animate__animated animate__fadeInUp animate__delay-3s">Explore Courses</a>
            </div>
            <div class="col-md-6 animate__animated animate__fadeInRight animate__delay-1s">
                <div class="image-shape">
                    <img src="~/images/boy.jpeg" alt="Learning" class="img-fluid rounded shadow-lg" />
                </div>
            </div>
        </div>
    </div>
</section>




