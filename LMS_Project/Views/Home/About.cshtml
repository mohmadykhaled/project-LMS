@{
    ViewData["Title"] = "About Us";
}

<section class="py-5" style="background-color: #f8f9fa;">
    <div class="container">
        <h2 class="text-center mb-4 fw-bold">About Us</h2>
        <p class="text-center text-muted mb-5">Welcome to LMS Project — your trusted platform for online learning.</p>

        <div class="row align-items-center">
            <!-- الصورة على الشمال -->
            <div class="col-md-6 mb-4 text-center">
                <img src="~/images/about.jpeg" alt="Online Learning" class="img-fluid rounded shadow" style="max-height: 350px;">
            </div>

            <!-- النص على اليمين -->
            <div class="col-md-6 mb-4">
                <h4 class="fw-bold mb-3">🎯 Our Mission</h4>
                <p style="font-size: 1.1rem;">
                    We aim to make quality education accessible to everyone by offering a wide range of
                    online courses from expert instructors.
                </p>

                <h4 class="fw-bold mt-4 mb-3">💡 Why Choose Us?</h4>
                <ul class="list-unstyled" style="font-size: 1.1rem;">
                    <li class="mb-2">✔ Expert Instructors</li>
                    <li class="mb-2">✔ Flexible Learning Options</li>
                    <li class="mb-2">✔ Recognized Certifications</li>
                    <li class="mb-2">✔ Community Support</li>
                </ul>
            </div>
        </div>
    </div>
</section>

