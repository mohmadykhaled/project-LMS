@model LMS_Project.ViewModel.ContactForm;
@{
    ViewData["Title"] = "Contact Us";
}

<div class="contact-page">
    <div class="container py-5">
        <div class="row">
            <div class="col-md-6">
                <h2 class="mb-4">Contact Us</h2>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="Submit" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Full Name</label>
                        <input asp-for="Name" class="form-control" required>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" required>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Message" class="form-label">Message</label>
                        <textarea asp-for="Message" class="form-control" rows="5" required></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Send Message</button>
                </form>
            </div>

            <div class="col-md-6">
                <div class="contact-info">
                    <h3 class="mb-4">Contact Information</h3>
                    <p><i class="fas fa-map-marker-alt me-2"></i> 123 Learning St, Cairo, Egypt</p>
                    <p><i class="fas fa-phone me-2"></i> +20 123 456 7890</p>
                    <p><i class="fas fa-envelope me-2"></i> info@smartlms.com</p>

                    <div class="social-links mt-4">
                        <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}