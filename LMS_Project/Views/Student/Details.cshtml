@model LMS_Project.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-5">
    <div class="row">
        <!-- Course Image -->
        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Course Image</label>
            <div class="mt-2">
                <img id="imagePreview"
                     src="@(Model.ImageUrl != null ? "/images/courses/" + Model.ImageUrl : "/images/placeholder.jpg")"
                     alt="Preview"
                     class="img-thumbnail"
                     style="height: 200px; width: 100%; max-width: 400px; object-fit: cover;" />
            </div>
        </div>

        <!-- Course Info -->
        <div class="col-md-7">
            <h2 class="fw-bold">@Model.CourseName</h2>
            <h5 class="text-muted">@Model.Title</h5>
            <p class="mt-3">@Model.Description</p>

            <div class="mb-3">
                <strong>Price:</strong> <span class="text-success fs-5">$@Model.Price</span>
            </div>

            <div class="mb-3">
                <strong>Instructor:</strong> @Model.Instructor?.User.FullName ?? $"Instructor ID: {Model.InstructorId}"
            </div>

            <!-- Enroll Button -->
            <form asp-action="EnrollConfirm" asp-controller="Student" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" value="@Model.CourseId" />
                <button type="submit" class="btn btn-primary btn-lg mt-2">Enroll Now</button>
            </form>

            <!-- Success Message -->
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info mt-3">
                    @TempData["Message"]
                </div>
            }

            <div class="mt-4">
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Back to Courses</a>
            </div>
        </div>
    </div>
</div>
